// MealBoard data model.
//
// Local dev uses SQLite for zero-config setup. SQLite has no array or enum
// column types, so:
//   - tag-like lists (mealTypes, sourceRecipeIds) are stored as JSON strings
//     and (de)serialized via helpers in lib/tags.ts
//   - "enum" fields (mealSlot, category, diet, cuisine) are plain strings
//     validated by zod in lib/validation.ts
//
// To move to PostgreSQL later: change `provider` to "postgresql", point
// DATABASE_URL at the Postgres instance, and re-run migrations. The JSON-string
// columns keep working; you can migrate them to native arrays as a follow-up.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  recipes          Recipe[]
  plannerEntries   PlannerEntry[]
  shoppingListItems ShoppingListItem[]
}

model Recipe {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String   @default("")
  imageUrl        String?
  prepTimeMinutes Int      @default(0)
  cookTimeMinutes Int      @default(0)
  servings        Int      @default(1)
  cuisine         String?
  diet            String?
  mealTypes       String   @default("[]") // JSON string[]: "breakfast" | "lunch" | "dinner" | "snack"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ingredients    Ingredient[]
  steps          InstructionStep[]
  plannerEntries PlannerEntry[]

  @@index([userId])
}

model Ingredient {
  id       String  @id @default(cuid())
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  quantity Float?
  unit     String?
  order    Int     @default(0)

  @@index([recipeId])
}

model InstructionStep {
  id         String @id @default(cuid())
  recipeId   String
  recipe     Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stepNumber Int
  text       String

  @@index([recipeId])
}

model PlannerEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  date      DateTime // UTC midnight of the planned day
  mealSlot  String   // "breakfast" | "lunch" | "dinner"
  createdAt DateTime @default(now())

  @@unique([userId, date, mealSlot])
  @@index([userId])
}

model ShoppingListItem {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientName  String
  quantity        Float?
  unit            String?
  category        String   @default("other")
  checked         Boolean  @default(false)
  sourceRecipeIds String   @default("[]") // JSON string[]
  weekStart       DateTime // UTC midnight Monday of the target week
  createdAt       DateTime @default(now())

  @@index([userId, weekStart])
}
